PORT=3000
API_KEY=change-me-in-production
DB_PATH=./data/padron.db
UPLOAD_DIR=./data/padrones
MAX_BATCH_CUITS=500
LOG_LEVEL=info
NODE_ENV=development
ALLOWED_PADRON_TYPES=ARBA,AGIP,IIBB_CABA,IIBB_SANTA_FE,IIBB_CORDOBA
# Layouts de archivo admitidos por tipo de padron: TIPO:LAYOUT[,LAYOUT]|TIPO:LAYOUT
# Layouts conocidos: UNIFICADO (11/12 campos, sin prefijo; lo publican ARBA y AGIP), PERCEPCION (prefijo P), RETENCION (prefijo R)
# Un tipo sin entrada acepta cualquier layout. Dejar vacio (PADRON_LAYOUTS=) desactiva la politica.
PADRON_LAYOUTS=ARBA:UNIFICADO|AGIP:UNIFICADO
