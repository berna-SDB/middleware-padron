PORT=3000
# Zona horaria para mostrar las horas de carga en el panel (los datos se guardan en UTC)
TIMEZONE=America/Argentina/Buenos_Aires
API_KEY=change-me-in-production
DB_PATH=./data/padron.db
UPLOAD_DIR=./data/padrones
MAX_BATCH_CUITS=500
LOG_LEVEL=info
NODE_ENV=development
ALLOWED_PADRON_TYPES=ARBA,AGIP,IIBB_CABA,IIBB_SANTA_FE,IIBB_CORDOBA
# Layouts de archivo admitidos por tipo de padron: TIPO:LAYOUT[,LAYOUT]|TIPO:LAYOUT
# Layouts conocidos: UNIFICADO (12 campos sin prefijo, AGIP), RGS_PERCEPCION y RGS_RETENCION (prefijo P/R con grupo, ARBA),
# LUA_PERCEPCION y LUA_RETENCION (prefijo P/R sin grupo, Cordoba). PERCEPCION y RETENCION a secas admiten las dos variantes.
# Un tipo sin entrada acepta cualquier layout. Dejar vacio (PADRON_LAYOUTS=) desactiva la politica.
PADRON_LAYOUTS=ARBA:RGS_PERCEPCION,RGS_RETENCION|AGIP:UNIFICADO|IIBB_CORDOBA:LUA_PERCEPCION,LUA_RETENCION
